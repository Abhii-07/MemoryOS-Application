# MemoryOS Phase 5 — assistant provider config.
# Copy this file to `.env` (gitignored) and fill only what you test.
# Never commit `.env` — keys stay server-side, the client never sees them.

# Active provider for hosted deploys: openrouter | openai | anthropic.
# Unset = auto: first configured cloud provider, else local Ollama (dev).
MEMORYOS_ASSIST_PROVIDER=openrouter

# Ollama — LOCAL DEV ONLY (no cloud presence; no key needed).
MEMORYOS_OLLAMA_ENDPOINT=http://127.0.0.1:11434
MEMORYOS_OLLAMA_MODEL=llama3.2

# OpenRouter — prod default. One key, free-tier models available.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest